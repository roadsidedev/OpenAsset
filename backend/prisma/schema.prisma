generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// User preferences and profile
model User {
    address        String   @id
    email          String?
    emailVerified  Boolean  @default(false)
    sms            String?
    smsVerified    Boolean  @default(false)
    pushEnabled    Boolean  @default(false)
    pushToken      String?
    emailAllAlerts Boolean  @default(false)
    nonce          String    @default(dbgenerated("gen_random_uuid()"))
    nonceExpiresAt DateTime?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    loans   Loan[]   @relation("BorrowerLoans")
    markets Market[] @relation("LPMarkets")
    alerts  Alert[]

    @@map("users")
}

// Track indexing progress
model SyncState {
    id        String   @id // e.g., "event_indexer"
    lastBlock Int
    updatedAt DateTime @updatedAt

    @@map("sync_states")
}

// Adapter Registry — tracks all registered adapters with trust metadata
model Adapter {
    id               Int         @id @default(autoincrement())
    adapterAddress   String
    chainId          Int         @default(11155111)
    adapterType      AdapterType
    registeredBy     String
    verified         Boolean     @default(false)
    deprecated       Boolean     @default(false)
    auditReference   String?
    totalValueSecured String    @default("0")
    registeredAt     DateTime    @default(now())

    @@unique([adapterAddress, chainId])
    @@index([adapterType])
    @@index([verified])
    @@index([chainId])
    @@map("adapters")
}

// Lending Market configuration and state (V2 — adapter-based)
model Market {
    id              String    @id @default(uuid())
    address         String    @unique // Contract address
    chainId         Int       @default(11155111)
    lpAddress       String
    collateralAsset String    // Address of collateral token
    lendingAsset    String    // Stablecoin only (V2)
    providerId      String?   // keccak256 provider bundle identifier

    // The five adapters (V2 core)
    assetAdapter      String
    oracleAdapter     String
    complianceAdapter String?   // nullable — optional
    liquidationAdapter String
    positionAdapter   String

    // Terms
    ltvBasisPoints   Int
    aprBasisPoints   Int
    durationSeconds  Int
    gracePeriodHours Int

    // Risk Controls
    enableHealthFactor    Boolean
    healthFactorThreshold Int?

    // Circuit Breaker
    circuitBreakerEnabled Boolean
    pauseThresholdBps     Int?
    lookbackPeriodSeconds Int?
    resumeThresholdBps    Int?
    cooldownSeconds       Int?

    // State
    status             MarketStatus @default(ACTIVE)
    pausedAt           DateTime?
    totalLiquidity     String       @default("0")
    availableLiquidity String       @default("0")
    totalBorrowed      String       @default("0")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    owner        User           @relation("LPMarkets", fields: [lpAddress], references: [address])
    loans        Loan[]
    priceHistory PriceHistory[]

    @@index([lpAddress])
    @@index([collateralAsset])
    @@index([providerId])
    @@index([status])
    @@index([assetAdapter])
    @@index([oracleAdapter])
    @@map("markets")
}

// Individual Loans (V2 — stored in market mapping, not standalone contracts)
model Loan {
    id                    String  @id @default(uuid())
    contractLoanId        String  // uint256 loan ID on LendingMarketV2
    marketAddress         String
    positionHolderAddress String  // Current holder (may differ from original borrower for TransferablePosition)

    // Amounts
    collateralAmount String  @default("0")
    principal        String  @default("0")

    // Timing
    startTime       DateTime
    expiryTime      DateTime
    frozenInterestAt DateTime? // Set when entering LIQUIDATION_CURE; 0 otherwise

    // Status
    status LoanStatus @default(ACTIVE)

    // Health (Updated via monitoring service)
    healthFactor    Float?
    lastHealthCheck DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    market   Market  @relation(fields: [marketAddress], references: [address])
    borrower User?   @relation("BorrowerLoans", fields: [positionHolderAddress], references: [address])
    alerts   Alert[]

    repaidAt     DateTime?
    liquidatedAt DateTime?

    @@unique([marketAddress, contractLoanId])
    @@index([positionHolderAddress])
    @@index([status])
    @@map("loans")
}

model LiquidityPosition {
    marketAddress       String
    lpAddress           String
    lpTokenBalance      BigInt   @default(0)
    stablecoinDeposited BigInt   @default(0)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@id([marketAddress, lpAddress])
    @@map("liquidity_positions")
}

// Historical Prices for Volatility/Circuit Breaker
model PriceHistory {
    id            String   @id @default(uuid())
    marketAddress String
    price         String // Stored as string to preserve precision
    source        String // "TWAP", "SPOT"
    timestamp     DateTime @default(now())

    market Market @relation(fields: [marketAddress], references: [address])

    @@index([marketAddress, timestamp])
    @@map("price_history")
}

// Notification Logs
model Alert {
    id         String      @id @default(uuid())
    userId     String
    loanId     String?
    type       AlertType
    level      AlertLevel
    message    String
    status     AlertStatus @default(PENDING)
    retryCount Int         @default(0)
    sentVia    String[] // ["email", "sms", "push"]
    sentAt     DateTime    @default(now())

    user User  @relation(fields: [userId], references: [address])
    loan Loan? @relation(fields: [loanId], references: [id])

    @@index([userId])
    @@map("alerts")
}

enum AlertStatus {
    PENDING
    SENT
    FAILED
}

model VerificationCode {
    id        String   @id @default(uuid())
    address   String
    code      String
    type      String // "EMAIL" or "SMS"
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@index([address, type])
    @@map("verification_codes")
}

// B20 curated token registry — hybrid of KNOWN_B20_TOKENS_BASE + B20Created indexing
model B20Token {
    address        String
    chainId        Int
    name           String
    symbol         String
    feed           String?  // Chainlink TRV feed address (8→18)
    decimals       Int      @default(18)
    extraMetadata  Json? // {isin, cusip, ...} from ExtraMetadataUpdated
    firstSeenBlock Int?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([address, chainId])
    @@index([chainId])
    @@index([symbol])
    @@map("b20_tokens")
}

model B20CorporateAction {
    id           String   @id @default(uuid())
    tokenAddress String
    chainId      Int
    actionType   String // UIMultiplierUpdated | MultiplierUpdated | Announcement | EndAnnouncement | ExtraMetadataUpdated | UIMultiplierUpdateCancelled
    txHash       String?
    blockNumber  Int?
    metadata     Json?
    createdAt    DateTime @default(now())

    @@index([tokenAddress, chainId])
    @@index([actionType])
    @@index([chainId])
    @@map("b20_corporate_actions")
}

enum AdapterType {
    ASSET
    ORACLE
    COMPLIANCE
    LIQUIDATION
    POSITION
}

enum MarketStatus {
    ACTIVE
    PAUSED_VOLATILITY
    PAUSED_STALE_ORACLE
    PAUSED_MANUAL
}

enum LoanStatus {
    ACTIVE
    GRACE_PERIOD
    LIQUIDATION_CURE
    LIQUIDATION_SETTLING
    REPAID
    LIQUIDATED
}

enum AlertType {
    HEALTH_FACTOR
    LIQUIDATION_RISK
    MARKET_PAUSED
    LOAN_EXPIRING
    LIQUIDATION_CURE_WARNING
    CURE_WINDOW_EXPIRING
    SETTLEMENT_TIMEOUT
}

enum AlertLevel {
    WATCH
    WARNING
    CRITICAL
}
