# Red Chips Smart Contracts - Environment Variables

# ===========================================
# REQUIRED: Deployment Private Key
# ===========================================
# Your wallet private key (without 0x prefix)
# ⚠️ NEVER commit this file with real keys!
PRIVATE_KEY=your_private_key_here

# ===========================================
# RPC Endpoints (Get from Alchemy/Infura)
# ===========================================
# Ethereum Sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Base Sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base Mainnet (for production)
BASE_RPC_URL=https://mainnet.base.org

# Ethereum Mainnet (for forking)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ===========================================
# Contract Verification API Keys
# ===========================================
# Etherscan (for Ethereum networks)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Basescan (for Base networks)
BASESCAN_API_KEY=your_basescan_api_key

# ===========================================
# Optional: Gas Reporting
# ===========================================
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# ===========================================
# Testnet Addresses (will be filled after deployment)
# ===========================================
# Sepolia Deployed Contracts
SEPOLIA_LOAN_IMPLEMENTATION=
SEPOLIA_MARKET_FACTORY=
SEPOLIA_NFT_ORACLE=

# Base Sepolia Deployed Contracts
BASE_SEPOLIA_LOAN_IMPLEMENTATION=
BASE_SEPOLIA_MARKET_FACTORY=
BASE_SEPOLIA_NFT_ORACLE=

# ===========================================
# External Contract Addresses
# ===========================================
# Sepolia
SEPOLIA_USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
SEPOLIA_CHAINLINK_ETH_USD=0x694AA1769357215DE4FAC081bf1f309aDC325306

# Base Sepolia
BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_CHAINLINK_ETH_USD=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1
