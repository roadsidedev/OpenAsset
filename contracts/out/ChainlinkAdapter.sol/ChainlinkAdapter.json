Trusted == false.\",\"returns\":{\"isTrusted\":\"Whether the price is currently reliable\",\"price\":\"Price in USD with 18 decimals (1e18 = $1.00)\",\"updatedAt\":\"Unix timestamp of the last price update\"}}},\"title\":\"ChainlinkAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"getHistoricalPrice(uint256)\":{\"notice\":\"Get a historical price from a given number of seconds ago\"},\"getPrice()\":{\"notice\":\"Get the current price and trust status\"}},\"notice\":\"Reference oracle adapter wrapping a Chainlink price feed\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/adapters/oracle/ChainlinkAdapter.sol\":\"ChainlinkAdapter\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@chainlink/=node_modules/@chainlink/\",\":@eth-optimism/=node_modules/@eth-optimism/\",\":@openzeppelin/=node_modules/@openzeppelin/\",\":@uniswap/=node_modules/@uniswap/\",\":base64-sol/=node_modules/base64-sol/\",\":eth-gas-reporter/=node_modules/eth-gas-reporter/\",\":forge-std/=lib/forge-std/src/\",\":hardhat/=node_modules/hardhat/\"],\"viaIR\":true},\"sources\":{\"node_modules/@chainlink/contracts/src/v0.8/interfaces/AggregatorV3Interface.sol\":{\"keccak256\":\"0xfe4e8bb4861bb3860ba890ab91a3b818ec66e5a8f544fb608cfcb73f433472cd\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://644cff84052e1e82b5bb502b2a46e8f142a62b0db4cd9b38200798ba8373c6f7\",\"dweb:/ipfs/QmTa99QHrJBn3SXDizquPBUiTxVCNKQrHgaWJhuds5Sce2\"]},\"src/adapters/oracle/ChainlinkAdapter.sol\":{\"keccak256\":\"0x00396dc66bde88ab69f2244f78580d600d5793b27d833fe5e27f83cca2ba4b2b\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://bb5064422cc5ab3c733e0560ded6a2db2f4565a806b630bc748d23d325ce45fd\",\"dweb:/ipfs/QmW6FxRcdy4hh8oDREm6jiz2Qeyo6vRaXcpzLnR8u3d2rP\"]},\"src/interfaces/adapters/IOracleAdapter.sol\":{\"keccak256\":\"0xeeb5c081e06701317f68f0362597268ea12ff973c9e18594665587be97a56dbb\",\"license\":\"MIT\",\"urls\":[