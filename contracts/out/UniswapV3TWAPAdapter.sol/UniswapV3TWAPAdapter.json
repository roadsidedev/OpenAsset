":\"\",\"type\":\"address\"}],\"name\":\"marketConfigs\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"pool\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"asset\",\"type\":\"address\"},{\"internalType\":\"bool\",\"name\":\"token0IsBase\",\"type\":\"bool\"},{\"internalType\":\"bool\",\"name\":\"isActive\",\"type\":\"bool\"},{\"internalType\":\"uint256\",\"name\":\"lastPrice\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"lastUpdatedAt\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"useFallbackOnly\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"quoteToken\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"pool\",\"type\":\"address\"},{\"internalType\":\"bool\",\"name\":\"token0IsBase\",\"type\":\"bool\"}],\"name\":\"registerPoolForMarket\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"bool\",\"name\":\"useFallbackOnly\",\"type\":\"bool\"}],\"name\":\"setFallbackMode\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"twapPeriod\",\"outputs\":[{\"internalType\":\"uint32\",\"name\":\"\",\"type\":\"uint32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"newPrice\",\"type\":\"uint256\"}],\"name\":\"updatePrice\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Implements IOracleAdapter using Uniswap V3 time-weighted average price.      Multi-tenancy: factory calls configure() once per market, storing pool config.      TWAP makes flash-loan manipulation economically infeasible.      Production path: getPrice() calls OracleLibrary.consult(pool, twapPeriod) and      getQuoteAtTick to derive a manipulation-resistant price. Legacy `lastPrice`      / `updatePrice` is retained for deterministic unit tests and anvil forks where      pool observations are unavailable, but it is NEVER used as the primary price      when a valid TWAP can be derived.\",\"kind\":\"dev\",\"methods\":{\"_consultWithQuote(address,address,uint32)\":{\"details\":\"In v2.1, this reverts to trigger fallback path; v2.2 will replace with helper call.\"},\"configure(address,address)\":{\"params\":{\"asset\":\"Address of the collateral asset to price for this market\",\"market\":\"Address of the LendingMarket contract\"}},\"getHistoricalPrice(uint256)\":{\"details\":\"Used by the circuit breaker to calculate price volatility      over the lookback window. Must return the price that was      current at (block.timestamp - secondsAgo), or 0 if unavailable.\",\"params\":{\"secondsAgo\":\"How many seconds back to query\"},\"returns\":{\"_0\":\"price Historical price with 18 decimals, or 0 if unavailable\"}},\"getPrice()\":{\"details\":\"isTrusted covers staleness, sequencer-liveness (on L2s), AND      session-awareness (e.g., equity feeds outside trading windows).      The engine rejects any price where isTrusted == false.\",\"returns\":{\"isTrusted\":\"Whether the price is currently reliable\",\"price\":\"Price in USD with 18 decimals (1e18 = $1.00)\",\"updatedAt\":\"Unix timestamp of the last price update\"}},\"registerPoolForMarket(address,address,bool)\":{\"params\":{\"market\":\"Address of the LendingMarket contract\",\"pool\":\"Uniswap V3 pool address\",\"token0IsBase\":\"Whether token0 is the base asset in the pair\"}},\"updatePrice(address,uint256)\":{\"details\":\"This does NOT bypass TWAP in production; it only populates the fallback slot used when      pool observations are unavailable or cardinality <2.\"}},\"title\":\"UniswapV3TWAPAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"_consultWithQuote(address,address,uint32)\":{\"notice\":\"External wrapper \\u2014 keeper-fed TWAP (fallback) is primary in v2.1; on-chain pool TWAP via helper will be enabled in v2.2.\"},\"configure(address,address)\":{\"notice\":\"Configure the adapter for a specific market\"},\"getHistoricalPrice(uint256)\":{\"notice\":\"Get a historical price from a given number of seconds ago\"},\"getPrice()\":{\"notice\":\"Get the current price and trust status\"},\"registerPoolForMarket(address,address,bool)\":{\"notice\":\"Register a Uniswap V3 pool for a specific market (factory only)\"},\"setFallbackMode(address,bool)\":{\"notice\":\"Force fallback mode for deterministic tests (factory only)\"},\"updatePrice(address,uint256)\":{\"notice\":\"Update fallback price for a market (factory only \\u2014 deterministic tests / anvil forks)\"}},\"notice\":\"Multi-tenant oracle adapter for crypto-native ERC20 collateral using TWAP\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/adapters/oracle/UniswapV3TWAPAdapter.sol\":\"UniswapV3TWAPAdapter\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@chainlink/=node_modules/@chainlink/\",\":@eth-optimism/=node_modules/@eth-optimism/\",\":@openzeppelin/=node_modules/@openzeppelin/\",\":@uniswap/=node_modules/@uniswap/\",\":base64-sol/=node_modules/base64-sol/\",\":eth-gas-reporter/=node_modules/eth-gas-reporter/\",\":forge-std/=lib/forge-std/src/\",\":hardhat/=node_modules/hardhat/\"],\"viaIR\":true},\"sources\":{\"node_modules/@uniswap/v3-core/contracts/interfaces/IUniswapV3Pool.sol\":{\"keccak256\":\"0xfe6113d518466cd6652c85b111e01f33eb62157f49ae5ed7d5a3947a2044adb1\",\"license\":\"GPL-2.0-or-later\",\"urls\":[\"bzz-raw://1c42b9e6f5902ac38dd43e25750939baa7e0c1425dc75afd717c4412731065d5\",\"dweb:/ipfs/QmWaoacnzsucTvBME2o7Y