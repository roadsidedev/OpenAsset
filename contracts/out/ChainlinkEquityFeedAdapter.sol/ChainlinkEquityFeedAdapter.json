":\"function\"},{\"inputs\":[],\"name\":\"tradingWindowStart\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Implements IOracleAdapter with:      - Session-aware 24/5 pricing (no live pricing over weekends/market holidays)      - L2 sequencer-uptime verification      - Staleness detection with configurable heartbeat      - Decimal normalization DO NOT use TWAP for this asset class \\u2014 equity/RWA markets require Chainlink's tokenized equity feeds or an equivalent issuer/NAV oracle. Outside the 24/5 trusted window, isTrusted returns false \\u2014 routes through the same circuit-breaker pause path as any other untrusted-oracle condition.Sequencer uptime check: On L2s (Base, Arbitrum, Optimism), a sequencer      outage can freeze the feed at a stale value. We verify the L2 sequencer      is live before trusting any price. On L1, this check is skipped.\",\"kind\":\"dev\",\"methods\":{\"getHistoricalPrice(uint256)\":{\"details\":\"Used by the circuit breaker to calculate price volatility      over the lookback window. Must return the price that was      current at (block.timestamp - secondsAgo), or 0 if unavailable.\",\"params\":{\"secondsAgo\":\"How many seconds back to query\"},\"returns\":{\"_0\":\"price Historical price with 18 decimals, or 0 if unavailable\"}},\"getPrice()\":{\"details\":\"isTrusted covers staleness, sequencer-liveness (on L2s), AND      session-awareness (e.g., equity feeds outside trading windows).      The engine rejects any price where isTrusted == false.\",\"returns\":{\"isTrusted\":\"Whether the price is currently reliable\",\"price\":\"Price in USD with 18 decimals (1e18 = $1.00)\",\"updatedAt\":\"Unix timestamp of the last price update\"}}},\"title\":\"ChainlinkEquityFeedAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"getHistoricalPrice(uint256)\":{\"notice\":\"Get a historical price from a given number o