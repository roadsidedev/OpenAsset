icalPrice(uint256)":"c6f47486","getPrice()":"98d5fdca","marketConfigs(address)":"6056527f","registerProvider(address,address,address,uint256,uint8)":"48684256"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_factory\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"configure\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"factory\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"name\":\"getHistoricalPrice\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"getPrice\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"price\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"isTrusted\",\"type\":\"bool\"},{\"internalType\":\"uint256\",\"name\":\"updatedAt\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"marketConfigs\",\"outputs\":[{\"internalType\":\"contract INAVProvider\",\"name\":\"navProvider\",\"type\":\"address\"},{\"internalType\":\"contract IProofOfReserve\",\"name\":\"proofOfReserve\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"maxStaleness\",\"type\":\"uint256\"},{\"internalType\":\"uint8\",\"name\":\"tokenDecimals\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"_navProvider\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"_proofOfReserve\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"_maxStaleness\",\"type\":\"uint256\"},{\"internalType\":\"uint8\",\"name\":\"_tokenDecimals\",\"type\":\"uint8\"}],\"name\":\"registerProvider\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Implements IOracleAdapter using issuer-published NAV, ideally paired      with Chainlink Proof of Reserve. Requires issuer cooperation \\u2014 the issuer must publish NAV on-chain via the INAVProvider interface (or equivalent mechanism). The adapter reads NAV per share and derives the asset price. When paired with Proof of Reserve, it can also verify that reserves cover the outstanding token supply (not enforced on-chain here, but available for off-chain monitoring). isTrusted returns false if: - NAV is stale (not updated within maxStaleness) - NAV is zero - PoR indicates reserves are insufficient (if PoR is configured)\",\"kind\":\"dev\",\"methods\":{\"getHistoricalPrice(uint256)\":{\"details\":\"Used by the circuit breaker to calculate price volatility      over the lookback window. Must return the price that was      current at (block.timestamp - secondsAgo), or 0 if unavailable.\",\"params\":{\"secondsAgo\":\"How many seconds back to query\"},\"returns\":{\"_0\":\"price Historical price with 18 decimals, or 0 if unavailable\"}},\"getPrice()\":{\"details\":\"isTrusted covers staleness, sequencer-liveness (on L2s), AND      session-awareness (e.g., equity feeds outside trading windows).      The engine rejects any price where isTrusted == false.\",\"returns\":{\"isTrusted\":\"Whether the price is currently reliable\",\"price\":\"Price in USD with 18 decimals (1e18 = $1.00)\",\"updatedAt\":\"Unix timestamp of the last price update\"}},\"registerProvider(address,address,address,uint256,uint8)\":{\"params\":{\"_maxStaleness\":\"Maximum age before price is considered stale\",\"_navProvider\":\"NAV provider contract address\",\"_proofOfReserve\":\"Proof of Reserve contract address (address(0) if none)\",\"_tokenDecimals\":\"Token decimals for NAV normalization\",\"market\":\"Address of the LendingMarket contract\"}}},\"title\":\"NAVOracleAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"getHistoricalPrice(uint256)\":{\"notice\":\"Get a historical price from a given number of seconds ago\"},\"getPrice()\":{\"notice\":\"Get the current price and trust status\"},\"registerProvider(address,address,address,uint256,uint8)\":{\"notice\":\"Register a NAV provider for a specific market\"}},\"notice\":\"Reference oracle adapter for fund-like RWA (tokenized treasuries, private credit)\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/adapters/rwa/NAVOracleAdapter.sol\":\"NAVOracleAdapter\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@chainlink/=node_modules/@chainlink/\",\":@eth-optimism/=node_modules/@eth-optimism/\",\":@openzeppelin/=node_modules/@openzeppelin/\",\":@uniswap/=node_modules/@uniswap/\",\":base64-sol/=node_modules/base64-sol/\",\":eth-gas-reporter/=node_modules/eth-gas-reporter/\",\":forge-std/=lib/forge-std/src/\",\":hardhat/=node_modules/hardhat/\"],\"viaIR\":true},\"sources\":{\"src/adapters/rwa/NAVOracleAdapter.sol\":{\"keccak256\":\"0x0db7ff00027f53f938dce3ac2ec946854a88f860810678bf18351f168d36e2cf\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://1aff6fe8848d33d185a548ed2adf3842323e957c5f32b288efd04d614395c1fa\",\"dweb:/ipfs/QmayxzPKErbMFSgdCit6srU41Lc9WUkm2s2ZCu3USLJvoG\"]},\"src/interfaces/adapters/IOracleAdapter.sol\":{\"keccak256\":\"0x0bb678aa2b71d7b76247cdde1d932fce059c2903e30d91a27dad27a806a9c617\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://c1ea58f2928cfbf9806e9ec3456f4e907e1dad56b532910b0710e85d480c2f14\",\"dweb:/ipfs/Qmb2Wa82zTuks3oNgNhVXG2GW