"2efd5b06","factory()":"c45a0155","isReleaseable(address,uint256)":"45d82d55","isTransferable(address,address,uint256)":"2f318039","marketConfigs(address)":"6056527f","policyRegistry()":"1c4dd7d0","release(address,uint256)":"0357371d","scaledBalanceOf(address,address)":"b99387ce"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_factory\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"_policyRegistry\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"B20ReleaseUnauthorized\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"}],\"name\":\"InvalidB20Token\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"CollateralEscrowed\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"CollateralReleased\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"}],\"name\":\"MarketConfigured\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"collateralToken\",\"type\":\"address\"}],\"name\":\"configure\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amountOrId\",\"type\":\"uint256\"}],\"name\":\"escrow\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"factory\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amountOrId\",\"type\":\"uint256\"}],\"name\":\"isReleaseable\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amountOrId\",\"type\":\"uint256\"}],\"name\":\"isTransferable\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"marketConfigs\",\"outputs\":[{\"internalType\":\"contract IB20\",\"name\":\"token\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"policyRegistry\",\"outputs\":[{\"internalType\":\"contract IPolicyRegistry\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amountOrId\",\"type\":\"uint256\"}],\"name\":\"release\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"account\",\"type\":\"address\"}],\"name\":\"scaledBalanceOf\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Implements IAssetAdapter with:  - Standard ERC-20 escrow/release via SafeERC20 (B20 is ERC-20 compatible)  - Policy-aware isTransferable (checks sender + receiver + executor slots via PolicyRegistry)  - Pause awareness (Transfers feature)  - Multi-tenancy: factory calls configure(market, collateralToken) once per market.    Per-market config keyed by market address (mirrors ERC20Adapter.sol:21 pattern). Trust model: engine verifies balance delta post-escrow (LendingMarketV2.sol:383) so under-delivery reverts regardless of adapter bug. Policy reverts at origination are atomic and safe (TR \\u00a74).\",\"kind\":\"dev\",\"methods\":{\"configure(address,address)\":{\"params\":{\"collateralToken\":\"Address of the collateral token for this market\",\"market\":\"Address of the LendingMarket contract\"}},\"isTransferable(address,address,uint256)\":{\"details\":\"Checks: policy authorized for both parties, balance + allowance to MARKET (not adapter). Pause is intentionally NOT checked here \\u2014 it is a granular per-feature flag with unstable selector across B20 builds. A paused transfer will simply revert at escrow time and the engine's balance-delta invariant (LendingMarketV2.sol:383) will surface it atomically. isTransferable is a UX pre-check only.\"},\"release(address,uint256)\":{\"details\":\"Requires market has approved this adapter to spend its tokens. LendingMarketV2 constructor does max approval for collateralAsset when isContract(). Review H6: release-direction policy pre-check \\u2014 the B20 token enforces the market's sender policy and the recipient's receiver policy at transfer time; surfacing it here gives a precise revert BEFORE any protocol interaction and a view for frontends, instead of stranding the loan after debt collection.\"}},\"title\":\"B20AssetAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"configure(address,address)\":{\"notice\":\"Configure the adapter for a specific market\"},\"escrow(address,uint256)\":{\"notice\":\"Escrow B20 collateral from borrower to the calling market (msg.sender == market)\"},\"isReleaseable(address,uint256)\":{\"notice\":\"View pre-check for the release direction (review H6): can the market         release `amountOrId` to `to` given current B20 policies?\"},\"isTransferable(address,address,uint256)\":{\"notice\":\"Check if B20 transfer would succeed prior to spending gas on escrow\"},\"release(address,uint256)\":{\"notice\":\"Release B20 collateral from market to recipient\"},\"scaledBalanceOf(address,address)\":{\"notice\":\"Helper for UI/indexer: scaled balance for a market's token\"}},\"notice\":\"Multi-tenant asset adapter for Base B20 tokenized stocks\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/adapters/asset/B20AssetAdapter.sol\":\"B20AssetAdapter\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@chainlink/=node_modules/@chainlink/\",\":@eth-optimism/=node_modules/@eth-optimism/\",\":@openzeppelin/=node_modules/@openzeppelin/\",\":@uniswap/=node_modules/@uniswap/\",\":base64-sol/=node_modules/base64-sol/\",\":eth-gas-reporter/=node_modules/eth-gas-reporter/\",\":forge-std/=lib/forge-std/src/\",\":hardhat/=node_modules/hardhat/\"],\"viaIR\":true},\"sources\":{\"node_modules/@openzeppelin/contracts/token/ERC20/IERC20.sol\":{\"keccak256\":\"0x287b55befed2961a7eabd7d7b1b2839cbca8a5b80ef8dcbb25ed3d4c2002c305\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://bd39944e8fc06be6dbe2dd1d8449b5336e23c6a7ba3e8e9ae5ae0f37f35283f5\",\"dweb:/ipfs/QmPV3FGYjVwvKSgAXKUN3r9T9GwniZz83CxBpM7vyj2G53\"]},\"node_modules/@openzeppelin/contracts/token/ERC20/extensions/IERC20Permit.sol\":{\"keccak256\":\"0xb264c03a3442eb37a68ad620cefd1182766b58bee6cec4034