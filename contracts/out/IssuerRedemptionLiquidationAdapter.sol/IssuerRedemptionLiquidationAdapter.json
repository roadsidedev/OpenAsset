2595d","claimSettlement(uint256)":"7b4d9405","configure(address,address)":"e470d5cf","cureWindowSeconds()":"095ae390","factory()":"c45a0155","isAsynchronous()":"f93ddf11","liquidate(uint256,uint256)":"d296d1f1","loanRedemptionId(uint256)":"a3e94c26","marketConfigs(address)":"6056527f","registerIssuer(address,address,address,uint256)":"b9bb9e09","requiresCollateralHandoff()":"39deaac2"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_factory\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"loanId\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"redemptionId\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"RedemptionSubmitted\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"loanId\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"proceeds\",\"type\":\"uint256\"}],\"name\":\"SettlementConfirmed\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"}],\"name\":\"_balanceOf\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"proceeds\",\"type\":\"uint256\"}],\"name\":\"_forwardProceeds\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"forwarded\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"loanId\",\"type\":\"uint256\"}],\"name\":\"checkSettlement\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"settled\",\"type\":\"bool\"},{\"internalType\":\"uint256\",\"name\":\"proceeds\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"loanId\",\"type\":\"uint256\"}],\"name\":\"claimSettlement\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"recoveredForLP\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"returnedToHolder\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"assetAdapter\",\"type\":\"address\"}],\"name\":\"configure\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"cureWindowSeconds\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"factory\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"isAsynchronous\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"loanId\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"debtOwed\",\"type\":\"uint256\"}],\"name\":\"liquidate\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"recoveredForLP\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"returnedToHolder\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"name\":\"loanRedemptionId\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"marketConfigs\",\"outputs\":[{\"internalType\":\"contract IIssuerRedemption\",\"name\":\"issuerRedemption\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"tokenAddress\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"assetAdapter\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"cureWindow\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"isActive\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"market\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"redemptionContract\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"_cureWindowSeconds\",\"type\":\"uint256\"}],\"name\":\"registerIssuer\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"requiresCollateralHandoff\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"pure\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Implements ILiquidationAdapter with async liquidation and multi-tenancy:      1. Loan enters LIQUIDATION_CURE (reversible state)      2. During cure window, holder can repay frozen debt + penalty      3. After cure window expires, redemption is submitted to issuer      4. Settlement confirms asynchronously      Multi-tenancy: factory calls configure() once per market. Each market      specifies its issuer redemption contract, token address, and cure window.\",\"kind\":\"dev\",\"methods\":{\"checkSettlement(uint256)\":{\"params\":{\"loanId\":\"The loan to check\"}},\"claimSettlement(uint256)\":{\"details\":\"Only callable by a configured market. Verifies settlement via issuer, then transfers      `proceeds` of lending asset from this adapter (where issuer sent funds) to the calling market.      If the issuer sends funds directly to the market, this will return 0 recovered and the market      will verify via its own balance delta; callers should ensure proceeds reach the market either way.\",\"params\":{\"loanId\":\"The loan in SETTLING state\"},\"returns\":{\"recoveredForLP\":\"Amount of lending asset transferred to the market\",\"returnedToHolder\":\"Surplus already forwarded to holder (0 for this adapter \\u2014 holder surplus handled off-chain)\"}},\"configure(address,address)\":{\"params\":{\"assetAdapter\":\"Address of the market's Asset Adapter for collateral orchestration\",\"market\":\"Address of the LendingMarket contract\"}},\"cureWindowSeconds()\":{\"details\":\"Only meaningful when isAsynchronous() == true. Defines how long      a loan sits in LIQUIDATION_CURE before the redemption is      irreversibly submitted. Different issuers have different real-world      cutoffs for cancelling a submitted redemption instruction.\",\"returns\":{\"_0\":\"seconds Duration of the cure window in seconds\"}},\"isAsynchronous()\":{\"details\":\"Async adapters (e.g., IssuerRedemptionLiquidationAdapter) route      through LIQUIDATION_CURE / LIQUIDATION_SETTLING instead of      resolving in one transaction. See Section 8 of the Technical Reference.\",\"returns\":{\"_0\":\"asynchronous True if liquidation requires multi-step settlement\"}},\"liquidate(uint256,uint256)\":{\"details\":\"Must return both values to enforce the gradual liquidation shape.      For divisible assets (ERC20): return genuine token surplus.      For indivisible assets (ERC721): return 0 in token terms, pay      surplus as a cash side-payment from LP's available liquidity.      For async adapters (issuer redemption): submit the redemption      request and return the expected amounts (confirmation comes later).\",\"params\":{\"debtOwed\":\"Total debt owed (principal + interest + penalty)\",\"loanId\":\"The loan to liquidate\"},\"returns\":{\"recoveredForLP\":\"Value taken to satisfy debt + penalty\",\"returnedToHolder\":\"Surplus returned to the position holder\"}},\"registerIssuer(address,address,address,uint256)\":{\"params\":{\"_cureWindowSeconds\":\"Duration of the cure window\",\"market\":\"Address of the LendingMarket contract\",\"redemptionContract\":\"Issuer redemption contract address\",\"token\":\"Token address to redeem\"}},\"requiresCollateralHandoff()\":{\"details\":\"Synchronous DEX adapters consume collateral in their own contract. Async      issuer adapters generally submit a redemption request without a handoff.\"}},\"title\":\"IssuerRedemptionLiquidationAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"checkSettlement(uint256)\":{\"notice\":\"Check if a redemption has settled (called by keepers)\"},\"claimSettlement(uint256)\":{\"notice\":\"Claim settlement proceeds after issuer confirms redemption \\u2014 called by market's finalizeRedemptionSettlement\"},\"configure(address,address)\":{\"notice\":\"Configure the adapter for a specific market\"},\"cureWindowSeconds()\":{\"notice\":\"Duration of the cure window for async adapters\"},\"isAsynchronous()\":{\"notice\":\"Whether this adapter operates asynchronously\"},\"liquidate(uint256,uint256)\":{\"notice\":\"Execute liquidation of a defaulted loan\"},\"registerIssuer(address,address,address,uint256)\":{\"notice\":\"Register issuer redemption details for a market (factory only)\"},\"requiresCollateralHandoff()\":{\"notice\":\"Whether the market must hand collateral to this adapter before liquidation.\"}},\"notice\":\"Multi-tenant liquidation adapter for RWA / tokenized equity with issuer redemption\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/adapters/rwa/IssuerRedemptionLiquidationAdapter.sol\":\"IssuerRedemptionLiquidationAdapter\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@chainlink/=node_modules/@chainlink/\",\":@eth-optimism/=node_modules/@eth-optimism/\",\":@op