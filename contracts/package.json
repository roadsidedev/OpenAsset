{
  "name": "red-chips-contracts",
  "version": "1.0.0",
  "description": "Red Chips - Permissionless Asset Lending Infrastructure",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:unit": "hardhat test test/unit/",
    "test:integration": "hardhat test test/integration/",
    "test:oracle": "hardhat test test/unit/ChainlinkOracle.test.ts test/unit/OracleRouter.test.ts test/integration/LendingMarketOracles.test.ts",
    "test:chainlink": "hardhat test test/unit/ChainlinkOracle.test.ts",
    "test:router": "hardhat test test/unit/OracleRouter.test.ts",
    "test:lending": "hardhat test test/integration/LendingMarketOracles.test.ts",
    "test:watch": "hardhat test --watch",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:coverage": "hardhat coverage",
    "test:debug": "hardhat test --verbose",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network sepolia",
    "verify": "hardhat verify",
    "clean": "hardhat clean",
    "flatten": "hardhat flatten",
    "format": "prettier --write \"contracts/**/*.sol\" \"test/**/*.ts\"",
    "lint": "eslint test/ --ext .ts",
    "typechain": "hardhat typechain"
  },
  "keywords": [
    "defi",
    "lending",
    "oracle",
    "solidity",
    "ethereum"
  ],
  "author": "Red Chips Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@typechain/ethers-v6": "^11.0.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "chai": "^4.3.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.0.0",
    "ethers": "^6.0.0",
    "hardhat": "^2.17.0",
    "hardhat-gas-reporter": "^1.0.0",
    "prettier": "^2.8.0",
    "prettier-plugin-solidity": "^1.1.0",
    "solidity-coverage": "^0.8.0",
    "ts-node": "^10.0.0",
    "typechain": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@openzeppelin/contracts": "^4.9.0",
    "@uniswap/v3-core": "^1.0.0",
    "@uniswap/v3-periphery": "^1.4.0",
    "dotenv": "^16.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
